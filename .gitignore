# 依赖与构建产物
node_modules/
dist/

# 运行时生成的敏感配置（内含 jwtSecret / 数据库口令），严禁提交
config.json

# multer 上传临时目录
uploads/

# 本地环境变量
.env
.env.local
.env.*.local

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# Playwright MCP 调试产物
.playwright-mcp/

# IDE 与编辑器
.vscode/
.idea/

# 项目本地数据（AI 助手工作记忆 / 规划文档之外的内部状态，非项目代码）
.codebuddy/

# 旧仓库备份目录（本地空仓库的 .git 备份，勿提交）
.git_empty_backup/
