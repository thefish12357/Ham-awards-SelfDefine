# 复制为 .env 后按需修改：Copy-Item .env.example .env
# .env 已被 .gitignore 排除，不要提交

# ---------- 应用 ----------
# 宿主机访问端口（容器内固定 9993）
APP_HOST_PORT=9993
TZ=Asia/Shanghai
# true = 首次启动由 installer 容器自动完成安装；false = 手动打开安装向导
AUTO_INSTALL=true

# ---------- PostgreSQL ----------
POSTGRES_USER=ham
POSTGRES_PASSWORD=ham_pass
POSTGRES_DB=ham_awards
# 宿主机映射端口（容器内固定 5432）。仅本机开发连库用，可随便改
DB_HOST_PORT=55432

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=ham-awards
# S3 API 端口（容器内 9000）。浏览奖励背景图走这个地址，改了要同步
MINIO_HOST_PORT=9000
# Web 控制台端口（容器内 9001）
MINIO_CONSOLE_HOST_PORT=9001
# 写入奖状背景图 URL 时使用的对外主机名（浏览器要能解析，所以是 localhost）
MINIO_PUBLIC_ENDPOINT=localhost

# ---------- 首次自动安装时创建的管理员 ----------
ADMIN_CALLSIGN=ADMIN
ADMIN_PASSWORD=ChangeMe_123
ADMIN_PATH=admin
