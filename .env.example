# 复制为 .env 后按需修改：Copy-Item .env.example .env
# .env 已被 .gitignore 排除，不要提交
#
# ⚠️ 安全提醒（审计整改）：以下口令均为占位符，部署前必须改成高强度唯一值。
#   不要使用 ham_pass / minioadmin123 / ChangeMe_123 这类公开已知的弱口令。
#   建议：>=16 位随机串；数据库/MinIO/管理员三者互不相同。

# ---------- 应用 ----------
# 宿主机访问端口（容器内固定 9993）。默认仅绑定 127.0.0.1（见 docker-compose.yml）
APP_HOST_PORT=9993
TZ=Asia/Shanghai
# true = 首次启动由 installer 容器自动完成安装；false = 手动打开安装向导
AUTO_INSTALL=true

# 可选：逗号分隔的可信前端源（CORS）。留空 = 仅允许同源（最严格）。
# 仅当你的前端部署在与后端不同的域名时才需要填写，例如：https://awards.example.com
CORS_ORIGINS=

# 仅当应用位于可信反向代理之后时设为 true；直连部署保持 false。
# ★ 隧道部署（如 cloudflared tunnel --url http://localhost:9993）必须设为 true：
#   否则所有访客的 req.ip 都是隧道本地回环地址，会导致①登录/安装限流桶被所有人共享（一人失败误伤全员）
#   ②审计日志 IP 全是 127.0.0.1 无法溯源。设 true 后 Express 读取 cloudflared 注入的 CF-Connecting-IP 真实访客 IP。
#   前提：9993 只绑 127.0.0.1（见 docker-compose.yml），公网无法直连伪造这些头，因此 true 在此场景是安全的。
TRUST_PROXY=false

# 可选：安装接口的一次性 bootstrap 令牌。设置后，首次安装必须携带此令牌
# （docker-compose 的 installer 会自动读取并发送）。容器/公网部署强烈建议设置强随机值，
# 例如：INSTALL_TOKEN=$(openssl rand -hex 32)
INSTALL_TOKEN=

# 对外站点地址：奖状二维码 / 校验链接这类「会印在纸上、离开浏览器」的 URL 用它拼。
# 留空时依次回落到 OAUTH_REDIRECT_URI 的 origin、最后才是本次请求的 host ——
# 本机开发（localhost:9993）不留此项也能工作，但**生产必须填公网域名**，
# 否则从本机打开页面导出奖状时，二维码会印成 http://localhost:9993（别人扫了打不开）。
PUBLIC_BASE_URL=

# ---------- PostgreSQL ----------
POSTGRES_USER=ham
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=ham_awards
# 宿主机映射端口（容器内固定 5432）。默认仅绑定 127.0.0.1
DB_HOST_PORT=55432

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_BUCKET=ham-awards
# S3 API 端口（容器内 9000）。默认仅绑定 127.0.0.1
MINIO_HOST_PORT=9000
# Web 控制台端口（容器内 9001）。默认仅绑定 127.0.0.1
MINIO_CONSOLE_HOST_PORT=9001
# 写入奖状背景图 URL 时使用的对外主机名（浏览器要能解析，所以是 localhost）
MINIO_PUBLIC_ENDPOINT=localhost

# ---------- Redis（OAuth/LoTW 临时会话共享存储，多实例安全）----------
# OAuth 的 state/换码 与 LoTW 临时会话默认存进程内存；配 REDIS_URL 后改存 Redis，
# 多实例部署时节点间共享登录态/临时日志，不互相丢失。留空 = 内存回退（单实例/本地开发）。
# Docker 部署默认连内置 redis 服务；本地 node server.js 不配则自动回退内存。
REDIS_URL=redis://redis:6379

# ---------- 首次自动安装时创建的管理员 ----------
ADMIN_CALLSIGN=ADMIN
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
ADMIN_PATH=admin

# ---------- 演示实例（独立库 + 独立容器，公网单独地址，类似 demo.wavelog.org）----------
# 启用方式：docker compose --profile demo up -d --build
#   会额外拉起 demodb / demo / demo-installer / demo-seed 四个服务，
#   跑出一套完全独立的示例系统（独立数据库、独立 MinIO 桶、独立演示账号），不影响真实数据。
#   （下方变量仅在该 profile 下被使用；DEMO_ENABLED 不再单独控制，保留仅为兼容阅读。）
DEMO_ENABLED=true
DEMO_POSTGRES_DB=ham_awards_demo
DEMO_DB_HOST_PORT=55433
DEMO_ADMIN_CALLSIGN=DEMOADMIN
# ★ 演示实例的管理员口令（种子脚本要用它登录去建示例奖状，必须 >=12 位且非公开弱口令）
DEMO_ADMIN_PASSWORD=CHANGE_ME_strong_demo_admin_password
DEMO_BUCKET=ham-awards-demo
# 演示实例独立 MinIO（与生产 minio 物理隔离）：服务名 demominio，凭据/桶均独立。
DEMO_MINIO_ROOT_USER=demominioadmin
DEMO_MINIO_ROOT_PASSWORD=CHANGE_ME_strong_demo_minio_password
DEMO_MINIO_HOST_PORT=9002
DEMO_MINIO_CONSOLE_HOST_PORT=9003
# 演示实例独立 Redis（与生产 redis 物理隔离）
DEMO_REDIS_URL=redis://demoredis:6379
DEMO_APP_HOST_PORT=9994
# 演示实例公网地址：填到“生产站”落地页“体验演示系统”按钮（留空则生产站不显示该按钮）。
# 例：https://demo.xxx.your-tunnel.example  或 cloudflared quick tunnel 给的随机地址。
DEMO_URL=
# 演示实例落地页公示的演示账号（供访客登录试玩整个系统）
DEMO_USER=DEMO
DEMO_USER_PASSWORD=demo123456
# 仅演示实例容器需要：标记自身为演示环境（显示横幅 + 公示凭据）
DEMO_MODE=true
DEMO_PASS=demo123456

# ---------- OAuth（HamCQ 授权登录，可选）----------
# 应用凭据来自 HamCQ 审核邮件（应用 ID / 应用密钥）。留空 = 登录页不显示「使用 HamCQ 登录」。
# 放这里可避免重装后 config.json 丢失、登录按钮消失；app 容器读取这些环境变量覆盖 config.json 的 oauth 段。
# 改完执行 docker compose up -d app 生效（改了 server.js 才需 --build）。
OAUTH_ENABLED=false
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=https://forum.hamcq.cn/oauth/authorize
OAUTH_TOKEN_URL=https://forum.hamcq.cn/oauth/token
OAUTH_USERINFO_URL=https://forum.hamcq.cn/api/user
OAUTH_SCOPE=user.read
# ★ 必须与 HamCQ 后台登记的回调地址严格一致（含协议与路径）；使用临时隧道时域名会变，需同步更新
OAUTH_REDIRECT_URI=https://your-domain.example/api/auth/oauth/callback

# ---------- SMTP（腾讯企业邮 / 企业微信邮箱，用于注册验证 / 找回密码 / 通知）----------
# 留空 SMTP_HOST 或 SMTP_ENABLED=false = 完全不发信（功能自动降级，不报错）。
#
# ★ 推荐用**公共邮箱**做发信账号（多人可管、不绑定个人微信/手机、不随员工变动失效）：
#   企业微信管理后台 →【协作 → 邮箱 → 管理 → 公共邮箱】新建，再在**公共邮箱网页端**
#   【设置 → 收发信设置】开启 IMAP/SMTP（不开则客户端连不上）。
# ⚠️ 公共邮箱**没有独立登录密码**，下面的 SMTP_PASS 填的是【客户端授权码】：
#   管理后台公共邮箱列表点「密码」生成，或在公共邮箱网页端【设置 → 邮箱绑定】获取。
# ⚠️ 授权码在「使用成员被移出公共邮箱」时会**立即失效**（自动发信会突然挂）→ 成员名单别乱动。
# ⚠️ 腾讯要求 **From 地址与登录账号一致**，所以 SMTP_USER 就是收件人看到的发件地址。
#
# 自检（不真发信，只验连通 + AUTH）：node scripts/check-smtp.mjs --auth
# 端到端真投递一封：            node scripts/check-smtp.mjs --auth --send-to <你的收件箱>
SMTP_ENABLED=false
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 发件人显示名（收件人看到的是「显示名 <SMTP_USER>」）
SMTP_FROM_NAME=HamGlory 奖状系统
# 用户回信的收件地址，**同时**作为邮件签名里的「求助入口」。
# 推荐填对外总信箱（如 contact@example.com）：no-reply@ 只发不收，不给入口用户就没法求助。
# 留空 = 回信进发信邮箱（没人看），签名退化为「请联系本站管理员」。
SMTP_REPLY_TO=
#
# 关于「邮件通知」（通知 → 邮件转发，2026-09-30）：
#   · 哪些事件发邮件由**系统管理员**在「后台管理 → 邮件通知」里配置；
#   · 用户需自己在「用户中心 → 通知设置 → 邮件提醒」开启（默认关）；
#   · 设置存在 config.json 的 mail 段，改完立即生效（无需重启）；
#   · 演示站（DEMO_MODE=true / compose 的 demo 服务）永不发信。
