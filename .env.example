# 复制为 .env 后按需修改：Copy-Item .env.example .env
# .env 已被 .gitignore 排除，不要提交
#
# ⚠️ 安全提醒（审计整改）：以下口令均为占位符，部署前必须改成高强度唯一值。
#   不要使用 ham_pass / minioadmin123 / ChangeMe_123 这类公开已知的弱口令。
#   建议：>=16 位随机串；数据库/MinIO/管理员三者互不相同。

# ---------- 应用 ----------
# 宿主机访问端口（容器内固定 9993）。默认仅绑定 127.0.0.1（见 docker-compose.yml）
APP_HOST_PORT=9993
TZ=Asia/Shanghai
# true = 首次启动由 installer 容器自动完成安装；false = 手动打开安装向导
AUTO_INSTALL=true

# 可选：逗号分隔的可信前端源（CORS）。留空 = 仅允许同源（最严格）。
# 仅当你的前端部署在与后端不同的域名时才需要填写，例如：https://awards.example.com
CORS_ORIGINS=

# 可选：安装接口的一次性 bootstrap 令牌。设置后，首次安装必须携带此令牌
# （docker-compose 的 installer 会自动读取并发送）。容器/公网部署强烈建议设置强随机值，
# 例如：INSTALL_TOKEN=$(openssl rand -hex 32)
INSTALL_TOKEN=

# ---------- PostgreSQL ----------
POSTGRES_USER=ham
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=ham_awards
# 宿主机映射端口（容器内固定 5432）。默认仅绑定 127.0.0.1
DB_HOST_PORT=55432

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_BUCKET=ham-awards
# S3 API 端口（容器内 9000）。默认仅绑定 127.0.0.1
MINIO_HOST_PORT=9000
# Web 控制台端口（容器内 9001）。默认仅绑定 127.0.0.1
MINIO_CONSOLE_HOST_PORT=9001
# 写入奖状背景图 URL 时使用的对外主机名（浏览器要能解析，所以是 localhost）
MINIO_PUBLIC_ENDPOINT=localhost

# ---------- 首次自动安装时创建的管理员 ----------
ADMIN_CALLSIGN=ADMIN
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
ADMIN_PATH=admin
